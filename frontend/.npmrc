# @angular/fire's Angular 21 support is currently published under the "next"
# dist-tag as a release candidate (21.0.0-rc.0). Its peerDependencies chain
# (via the optional `@angular/platform-server` and required
# `@angular/platform-browser-dynamic` peers) causes npm's strict peer
# resolution (npm >=7 default) to either falsely report a conflict or take an
# extremely long time backtracking, even though the resolved versions are
# actually compatible. legacy-peer-deps restores npm v6-style peer handling
# (checked but not auto-resolved/enforced), which avoids both problems.
# Revisit/remove once @angular/fire ships a stable (non-RC) Angular 21 release.
legacy-peer-deps=true

